{
  "$schema": "https://charm.land/crush.json",
  "providers": {
    "openai-compat": {
      "id": "openai-compat",
      "name": "OpenAI Compat",
      "type": "openai-compat",
      "base_url": "https://api.example.com/v1",
      "api_key": "$OPENAI_API_KEY",
      "models": [
        {
          "id": "gpt-4o-mini",
          "name": "GPT-4o Mini",
          "cost_per_1m_in": 0.15,
          "cost_per_1m_out": 0.6,
          "cost_per_1m_in_cached": 0.075,
          "cost_per_1m_out_cached": 0.3,
          "context_window": 128000,
          "default_max_tokens": 4096,
          "can_reason": false,
          "supports_attachments": true
        }
      ]
    }
  },
  "models": {
    "large": {
      "provider": "openai-compat",
      "model": "gpt-4o-mini"
    }
  },
  "mcp": {
    "github": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"]
    }
  },
  "options": {
    "debug": false,
    "data_directory": ".crush"
  },
  "permissions": {
    "allowed_tools": ["view", "ls"]
  }
}
