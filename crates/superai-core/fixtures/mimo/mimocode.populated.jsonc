// Populated MiMo config with comments, trailing commas
{
  "$schema": "https://mimo.xiaomi.com/mimocode/config.json",
  "model": "xiaomi/mimo-v2.5", // primary
  "provider": {
    "openai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenAI",
      "options": {
        "baseURL": "https://api.openai.com/v1",
        "apiKey": "sk-fake-openai-123", // fake
      },
    },
  },
  "mcp": {
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "/tmp"],
    },
  },
  "plugin": ["@mimo-ai/plugin-example"],
  "skills": {
    "paths": ["/tmp/skills"],
  },
}
