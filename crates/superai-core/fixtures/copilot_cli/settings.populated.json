{
  "$schema": "https://json.schemastore.org/copilot-cli-settings.json",
  "model": "claude-sonnet-4.6",
  "provider": "openai",
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest"],
      "env": {}
    }
  },
  "enabledMcpServers": ["playwright"],
  "permissions": {
    "allow": ["shell(git:*)"],
    "deny": ["shell(rm -rf *)"]
  },
  "editor": "code"
}
